{
  "name": "wayband",
  "version": "1.0.0",
  "description": "Wayband — classless party tactics for the browser",
  "scripts": {
    "test": "esbuild scripts/validate-content.ts --bundle --platform=node --format=cjs --outfile=.test-build/content-check.cjs && node .test-build/content-check.cjs",
    "validate": "npm run check && npm test && npm run build",
    "balance": "esbuild scripts/balance-report.ts --bundle --platform=node --format=cjs --outfile=.test-build/balance-report.cjs && node .test-build/balance-report.cjs",
    "build": "esbuild src/main.ts --bundle --outfile=dist/game.js --minify --target=es2020",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/game.js --watch --servedir=.",
    "check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draphael123/wayfarer-rpg-v0.git"
  },
  "bugs": {
    "url": "https://github.com/draphael123/wayfarer-rpg-v0/issues"
  },
  "homepage": "https://github.com/draphael123/wayfarer-rpg-v0#readme",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
